          "id": "s6.upscale",
          "title": "超分（本地 Real-ESRGAN，免费）",
          "outputs": [{ "kind": "glob", "pattern": "{{dirs.dir}}/*{{deliverTag}}*.mp4", "min": 1 }],
          "acceptance": ["重烧目标分辨率字幕；与源帧 1:1 对比确认更清晰（质量型需求要看对比，不只看参数）"]
        },
        {
          "id": "s6.verify",
          "title": "核验（7 项）",
