          "acceptance": ["平台尺寸（如 B 站 1146×717）在内；定稿版本记进 cover.preset"]
        },
        {
          "id": "s7.copy",
          "title": "投稿文案",
          "outputs": [{ "kind": "anyOf", "of": [{ "kind": "glob", "pattern": "{{dirs.dir}}/投稿文案*", "min": 1 }, { "kind": "manual" }] }],
          "acceptance": ["与成片/封面署名同源；含 AI 生成与非商用声明"]
        }
      ],
      "actions": [
        {
          "id": "pv.cover.plan",
          "label": "封面预览（--plan）",
          "kind": "preview",
          "interpreter": "node",
          "argv": ["scripts/86_pv_cover.mjs", "--plan"],
          "writes": false,
          "costCny": 0,
          "timeoutMs": 120000
        },
        {
          "id": "pv.cover",
