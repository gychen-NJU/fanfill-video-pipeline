          "acceptance": ["规格/响度/指定画面/字幕/原创性/接缝逐项过；不通过的项列出来"]
        }
      ],
      "actions": [
        {
          "id": "pv.upscale.plan",
          "label": "超分预览（--plan）",
          "kind": "preview",
          "interpreter": "node",
          "argv": ["scripts/87_pv_upscale.mjs", "--plan"],
          "writes": false,
          "costCny": 0,
          "timeoutMs": 120000
        },
        {
          "id": "pv.verify.plan",
          "label": "核验预览（--plan）",
          "kind": "preview",
          "interpreter": "node",
          "argv": ["scripts/85_pv_verify.mjs", "--plan"],
          "writes": false,
          "costCny": 0,
          "timeoutMs": 120000
        }
      ],
      "artifacts": ["{{dirs.dir}}/", "{{dirs.verifyDir}}/"],
      "agentPrompt": "【工作台派单 · 阶段6 超分与核验】歌名「{{song.name}}」，歌根 {{root}}。请按技能阶段6：先 `node scripts/87_pv_upscale.mjs --plan` 确认交付分辨率与模型，再真跑超分；然后 `node scripts/85_pv_verify.mjs --w <宽> --h <高>` 跑 7 项核验，把逐项结果与抽帧路径给我。若有项不过，不要只看参数达标就下结论——把对比帧/对比段给我判。"
    },
    {
      "id": "s7",
      "n": 7,
      "line": "video",
      "title": "封面与投稿文案",
      "goal": "出封面（多版式/多尺寸）与投稿文案（含署名与 AI 标识）",
      "runner": "agent",
      "gate": "封面有定稿版本；文案含原曲署名 + AI 生成 + 非商用声明",
      "slots": [],
      "steps": [
        {
          "id": "s7.cover",
          "title": "封面（版式 × 尺寸）",
