    "lyrics": [
      {
        "t": 30.53,
        "text": "故事闯入夏天",
        "nominalEnd": 33.65,
        "onset": 30.36,
        "dev": -0.17,
        "onsetLevel": -58.944,
        "vocalEnd": 33.3
      },
      {
        "t": 33.65,
        "text": "在我最好年华中回响",
        "nominalEnd": 42.48,
        "onset": 33.82,
        "dev": 0.17,
        "onsetLevel": -37.373,
        "vocalEnd": 39.06
      },
      {
        "t": 42.48,
        "text": "看少女的成长",
        "nominalEnd": 45.99,
        "onset": 42.52,
        "dev": 0.04,
        "onsetLevel": -62.077,
        "vocalEnd": 45.5
      },
      {
        "t": 45.99,
        "text": "陪伴我把岁月走成温暖",
        "nominalEnd": 50.49,
        "onset": 46.14,
        "dev": 0.15,
        "onsetLevel": -34.466,
        "vocalEnd": 56.16
      },
      {
        "t": 50.49,
        "text": "为了美好而战",
        "nominalEnd": 54.2,
        "onset": 50.74,
        "dev": 0.25,
        "onsetLevel": -36.178,
        "vocalEnd": 56.16
      },
      {
        "t": 54.2,
        "text": "未曾想如若就此擦肩",
        "nominalEnd": 59.97,
        "onset": 53.42,
        "dev": -0.78,
        "onsetLevel": -29.665,
        "vocalEnd": 56.16
      },
      {
        "t": 59.97,
        "text": "会是此生错过最大的遗憾",
        "nominalEnd": 66.15,
        "onset": 59.94,
        "dev": -0.03,
        "onsetLevel": -43.397,
        "vocalEnd": 62
      },
      {
        "t": 66.15,
        "text": "会一直记得薪炎永燃",
        "nominalEnd": 71.96,
        "onset": 66.54,
        "dev": 0.39,
        "onsetLevel": -38.286,
        "vocalEnd": 68.54
      },
      {
        "t": 71.96,
        "text": "愿世上的美好都如愿绽放",
        "nominalEnd": 78.4,
        "onset": 71.84,
        "dev": -0.12,
        "onsetLevel": -39.211,
        "vocalEnd": 73.26
      },
      {
        "t": 78.4,
        "text": "哪怕有一天 泪花盛开",
        "nominalEnd": 81.58,
        "onset": 78.08,
        "dev": -0.32,
        "onsetLevel": -22.909,
        "vocalEnd": 81.4
      },
      {
        "t": 81.58,
        "text": "和你约定 别说再见",
        "nominalEnd": 84.67,
        "onset": 81.54,
        "dev": -0.04,
        "onsetLevel": -33.097,
        "vocalEnd": 90.64
      },
      {
        "t": 84.67,
        "text": "携愿的灯 星消的夜",
        "nominalEnd": 87.67,
        "onset": 84.62,
        "dev": -0.05,
        "onsetLevel": -30.317,
        "vocalEnd": 90.64
      },
      {
        "t": 87.67,
        "text": "太多眷恋 如何忘却",
        "nominalEnd": 90.82,
        "onset": 87.72,
        "dev": 0.05,
        "onsetLevel": -31.77,
        "vocalEnd": 90.64
      },
      {
        "t": 90.82,
        "text": "一如往昔 镌刻心间",
        "nominalEnd": 93.88,
        "onset": 90.88,
        "dev": 0.06,
        "onsetLevel": -22.786,
        "vocalEnd": 93.78
      },
      {
        "t": 93.88,
        "text": "亦如未来 前路仍远",
        "nominalEnd": 97,
        "onset": 94.02,
        "dev": 0.14,
        "onsetLevel": -26.196,
        "vocalEnd": 96.96
      },
      {
        "t": 97,
        "text": "梦醒啦 别再沉湎 寻梦向前",
        "nominalEnd": 127.25,
        "onset": 97.28,
        "dev": 0.28,
        "onsetLevel": -37.21,
        "vocalEnd": 103.32
      },
      {
        "t": 127.25,
        "text": "哪怕有一天 泪花盛开",
        "nominalEnd": 130.7,
        "onset": 126.68,
        "dev": -0.57,
        "onsetLevel": -54.347,
        "vocalEnd": 130.64
      },
      {
        "t": 130.7,
        "text": "和你约定 未来再见",
        "nominalEnd": 133.84,
        "onset": 130.88,
        "dev": 0.18,
        "onsetLevel": -23.85,
        "vocalEnd": 136.74
      },
      {
        "t": 133.84,
        "text": "仲夏的梦 红月的夜",
        "nominalEnd": 136.92,
        "onset": 133.82,
        "dev": -0.02,
        "onsetLevel": -34.349,
        "vocalEnd": 136.74
      },
      {
        "t": 136.92,
        "text": "太多感谢 如何忘却",
        "nominalEnd": 140.02,
        "onset": 137.02,
        "dev": 0.1,
        "onsetLevel": -30.807,
        "vocalEnd": 146.24
      },
      {
        "t": 140.02,
        "text": "终章不终 故事未完",
        "nominalEnd": 143.04,
        "onset": 140.04,
        "dev": 0.02,
        "onsetLevel": -25.347,
        "vocalEnd": 146.24
      },
      {
        "t": 143.04,
        "text": "序章又续 陪伴亦然",
        "nominalEnd": 146.21,
        "onset": 143.08,
        "dev": 0.04,
        "onsetLevel": -29.417,
        "vocalEnd": 146.24
      },
      {
        "t": 146.21,
        "text": "向前吧 走向前吧",
        "nominalEnd": 149.17,
        "onset": 146.46,
        "dev": 0.25,
        "onsetLevel": -39.041,
        "vocalEnd": 152.34
      },
      {
        "t": 149.17,
        "text": "往日画面 难忘永远",
        "nominalEnd": null,
        "onset": 149.98,
        "dev": 0.81,
        "onsetLevel": -22.599,
        "vocalEnd": 152.34
      }
